# Daily Shelf PostgreSQL backup, started by shelf-pg-backup.timer (see infra/storage.md).
[Unit]
Description=Shelf PostgreSQL backup to S3
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/shelf/backup.env
ExecStart=/usr/local/bin/shelf-pg-backup
DynamicUser=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
